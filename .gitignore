# ===== Godot 4 运行时缓存 =====
.godot/
/android/
*.translation~
# Godot 4.4 自动为脚本/资源生成的 UID 文件（引擎元数据，导入时自动重建，不入库）
*.uid

# ===== 导出产物（保留目录，不提交产物）=====
/exports/*
!/exports/.gitkeep
/export_presets.cfg.bak

# ===== 本地存档（服务端运行时生成，不提交）=====
/saves/*
!/saves/.gitkeep
# SaveManager 的 res:// 是 server/ 工程根，故实际落盘在 server/saves/（R7 起自动存档会生成 save_*.json）
/server/saves/*
!/server/saves/.gitkeep
*.save
*.sav

# ===== 日志 / 临时 =====
*.log
*.tmp
*.bak
*.swp
*~

# ===== 操作系统垃圾 =====
Thumbs.db
desktop.ini
.DS_Store

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.code-workspace

# ===== WorkBuddy 本地笔记（不入库）=====
.workbuddy-ai/

# ===== 环境与密钥 =====
.env
*.secret

# ===== 依赖 / 构建中间件 =====
node_modules/

# ===== shared 目录联接（由 tools/setup_shared.ps1 本地生成，勿入库；真正的源在顶层 shared/）=====
/client/shared/
/server/shared/

# ===== 本地 Godot 可执行文件路径（机器相关，不入库；见 docs/prompts/README.md）=====
/tools/godot_path.txt

# ===== 验收产物（确定性双跑导出，可由自测重新生成，不入库）=====
/outputs/
# Godot 的 res:// 是工程根，故客户端产物实际落在 client/outputs/（WorldShot 截图、探针脚本）
/client/outputs/
