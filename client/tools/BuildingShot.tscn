[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="Runner"]
script/source = "extends Node
func _ready() -> void:
	var shot_script: GDScript = load(\"res://tools/BuildingShot.gd\")
	if shot_script == null or not shot_script.can_instantiate():
		printerr(\"BUILDINGSHOT_FAIL 截图脚本未能编译\")
		get_tree().quit(1)
		return
	var shot_node: Node3D = Node3D.new()
	shot_node.set_script(shot_script)
	add_child(shot_node)
"

[node name="BuildingShot" type="Node"]
script = SubResource("Runner")
