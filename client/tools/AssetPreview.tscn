[gd_scene load_steps=2 format=3]

[sub_resource type="GDScript" id="Runner"]
script/source = "extends Node
func _ready() -> void:
	var preview_script: GDScript = load(\"res://tools/AssetPreview.gd\")
	if preview_script == null or not preview_script.can_instantiate():
		printerr(\"ASSETPREVIEW_FAIL 预览脚本未能编译\")
		get_tree().quit(1)
		return
	var preview_node: Node = Node.new()
	preview_node.set_script(preview_script)
	add_child(preview_node)
"

[node name="AssetPreview" type="Node"]
script = SubResource("Runner")
